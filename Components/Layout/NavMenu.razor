@inject NavigationManager Nm

<header class="flex items-center justify-between py-10">
    <div>
        <a href="">
            <h1 class="text-2xl font-semibold text-primary-800">@WebsiteKeys.Title</h1>
        </a>
    </div>
    <div class="flex items-center space-x-4 leading-5 sm:space-x-6">
        @foreach(var item in menuItems)
        {
            <NavLink ActiveClass="bg-primary-950 px-2 py-1 rounded-xl" class="font-medium text-gray-100"
                     Match="@(item.Link == "" ? NavLinkMatch.All : NavLinkMatch.Prefix)" href="@item.Link">
                @((MarkupString)item.Name)
                <Svg Icon="item.Icon"/>
            </NavLink>
        }
    </div>
</header>

@code
{
    List<MenuItem> menuItems =
    [
        new("Home", ""),
        new("Tags", "tags"),
        new("", WebsiteKeys.GitHubTemplateRepo, Svg.Icons.Github)
    ];


    record MenuItem(string Name, string Link, Svg.Icons? Icon = null);
}
